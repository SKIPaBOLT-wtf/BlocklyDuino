<xml>
  <block type="oled_ssd1306_spi_print" x="30" y="30">
    <field name="ROW">0</field>
    <value name="CONTENT">
      <block type="text">
        <field name="TEXT">Hello!</field>
      </block>
    </value>
    <next>
      <block type="oled_ssd1306_spi_print">
        <field name="ROW">2</field>
        <value name="CONTENT">
          <block type="inout_analog_read">
            <field name="PIN">A0</field>
          </block>
        </value>
        <next>
          <block type="base_delay">
            <value name="DELAY_TIME">
              <block type="math_number">
                <field name="NUM">500</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
