    <region id="area_irq" x="410" y="-30" width="520" height="230" color="#9067ac">
      <title>Interrupt handler</title>
      <description>Record the event quickly. Keep Serial and other slow work in loop.</description>
    </region>
    <region id="area_loop" x="410" y="205" width="640" height="650" color="#3185b5">
      <title>Main loop</title>
      <description>Attach or detach from Monitor; copy the shared counter atomically.</description>
    </region>
  </workspace-regions>
