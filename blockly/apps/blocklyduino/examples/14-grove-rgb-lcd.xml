<xml>
  <block type="grove_rgb_lcd_color" x="30" y="30">
    <field name="RGB">0, 0, 255</field>
    <next>
      <block type="grove_rgb_lcd_print">
        <field name="ROW">0</field>
        <value name="CONTENT">
          <block type="text">
            <field name="TEXT">Hello!</field>
          </block>
        </value>
        <next>
          <block type="grove_rgb_lcd_print">
            <field name="ROW">1</field>
            <value name="CONTENT">
              <block type="text">
                <field name="TEXT">RGB LCD</field>
              </block>
            </value>
            <next>
              <block type="base_delay">
                <value name="DELAY_TIME">
                  <block type="math_number">
                    <field name="NUM">1000</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
